# Supabase project settings (browser-safe URL and publishable/anon key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase secret. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter. Keep the API key server-side; never expose it to the browser.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=anthropic/claude-opus-5

# Optional deployment metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000
